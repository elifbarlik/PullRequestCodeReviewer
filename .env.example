# SecPR-TR — Ortam değişkenleri şablonu
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun.
# .env asla git'e eklenmez (.gitignore'da).

# ── Gemini ──────────────────────────────────────────────────────────
# Google AI Studio'dan alınan API anahtarı
GEMINI_API_KEY=

# ── GitHub App ─────────────────────────────────────────────────────
# GitHub Developer Settings > GitHub Apps > SecPR-TR > General altındaki App ID
GITHUB_APP_ID=

# Private key — iki yöntemden birini kullanın:
#
# Yöntem A (Railway / Docker için önerilen):
#   .pem dosyasını tek satıra çevirin:
#     python -c "print(open('secpr-tr.pem').read().replace('\n','\\n'))"
#   Çıktıyı buraya yapıştırın (tırnak içinde):
GITHUB_APP_PRIVATE_KEY=

# Yöntem B (yerel geliştirme için):
#   .pem dosyasının tam yolunu yazın (GITHUB_APP_PRIVATE_KEY boşsa bu kullanılır):
GITHUB_APP_PRIVATE_KEY_PATH=

# ── Webhook güvenliği ───────────────────────────────────────────────
# GitHub App kaydında belirlediğiniz webhook secret
# Üretmek için: python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=

# ── Eski (artık kullanılmıyor) ──────────────────────────────────────
# PAT tabanlı GITHUB_TOKEN Faz 1.2'de kaldırıldı.
# Tüm API çağrıları artık GitHub App installation token'larıyla yapılır.
# GITHUB_TOKEN=
