# Required for pull-request analysis
GEMINI_API_KEY=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# PostgreSQL. Docker Compose provides a local database by default.
DATABASE_URL=
POSTGRES_PASSWORD=

# Required by protected administrative endpoints
ADMIN_SECRET=

# Dashboard GitHub OAuth (required only for authenticated dashboard sign-in)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_SESSION_SECRET=
# Optional; defaults to https://<host>/auth/github/callback
GITHUB_OAUTH_REDIRECT_URI=

# Runtime / observability
ENVIRONMENT=local
HOURLY_PR_LIMIT=50
LOG_FORMAT=text
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# LLM cost controls
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=300
LLM_CACHE_MAX_ENTRIES=256
LLM_MAX_OUTPUT_TOKENS=2048
GEMINI_MODEL=gemini-2.5-flash
